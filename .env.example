# Render & Backend Environment Variables Reference
# Set these in Render Dashboard -> Service -> Environment

# Render auto-assigns PORT (do not hardcode in production)
PORT=8080

# MongoDB Atlas connection URI
# Replace <URL_ENCODED_NEW_PASSWORD> with your URL-encoded Atlas password
# Database name is cloudfileshare
MONGODB_URI=mongodb+srv://rajjaiswalwork_db_user:<URL_ENCODED_NEW_PASSWORD>@cloudfile.5uph4w6.mongodb.net/cloudfileshare?retryWrites=true&w=majority&appName=cloudfile

# Clerk Authentication (Clerk Dashboard -> API Keys / JWT Templates)
CLERK_ISSUER=https://sacred-monitor-7235.clerk.accounts.dev
CLERK_JWKS_URL=https://sacred-monitor-7235.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_signing_secret

# Razorpay Configuration (Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://cloudfileshare.netlify.app,http://localhost:5173,http://localhost:3000

# File Upload Configuration (Optional, defaults to 'upload')
FILE_UPLOAD_DIR=upload
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=25MB
